{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // firebase/auth publica los tipos web antes que los de React Native;
    // Metro sí carga la versión RN (con getReactNativePersistence).
    "paths": {
      "@firebase/auth": ["./node_modules/@firebase/auth/dist/rn/index.rn.d.ts"]
    }
  }
}
