rules_version = '2';

// Spots y Rack: el público los lee vía /api/spots (Admin SDK, ignora estas reglas).
// Desde el navegador solo el admin (custom claim admin) lee y escribe.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /spots/{spotId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow write: if isAdmin();
    }

    // Lugares de Rack: igual que los spots
    match /rack/{placeId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow write: if isAdmin();
    }

    // Configuración del admin (colonias agregadas a mano): sólo el admin
    match /meta/{docId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
