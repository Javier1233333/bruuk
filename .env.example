# ============================================================
# RACK por BRUUK — Variables de entorno
# Copia este archivo a .env para desarrollo local.
# En producción configúralas en Vercel → Settings → Environment Variables.
# NUNCA subas .env a git.
# ============================================================

# ── Firebase — Frontend (públicas, viajan al navegador) ─────
# Firebase Console → Configuración del proyecto → Tus apps → Web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── Firebase Admin — API serverless (SECRETAS, solo servidor) ─
# Configuración del proyecto → Cuentas de servicio → Generar clave privada.
# Copia project_id, client_email y private_key del JSON. En Vercel pega la
# private_key tal cual (con los \n); el código los convierte.
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@tu-proyecto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Supabase — API serverless (SECRETAS, solo servidor) ─────
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=eyJ...
# La service key ignora RLS. Jamás exponerla con prefijo VITE_.
SUPABASE_SERVICE_KEY=eyJ...

# ── Stripe (SECRETAS, solo servidor) ─────────────────────────
# Dashboard de Stripe → Developers → API keys
# Usa sk_test_... mientras pruebas; sk_live_... en producción.
STRIPE_SECRET_KEY=sk_test_...
# Dashboard → Developers → Webhooks → tu endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Rack admin ───────────────────────────────────────────────
# Clave para crear productos vía POST /api/rack/products
# (header x-admin-key). Genera una larga: openssl rand -hex 32
RACK_ADMIN_KEY=

# ── App admin ────────────────────────────────────────────────
# Clave para crear eventos vía POST /api/app/events
# (header x-admin-key). Genera una larga: openssl rand -hex 32
APP_ADMIN_KEY=

# ── Stripe webhook — App (SECRETO, solo servidor) ────────────
# Dashboard → Developers → Webhooks → endpoint /api/app/event-webhook
# → Signing secret. Variable DISTINTA a STRIPE_WEBHOOK_SECRET de Rack.
STRIPE_WEBHOOK_SECRET_APP=whsec_...

# ── Sitio ────────────────────────────────────────────────────
# URL pública para los redirects de Stripe (success/cancel).
# En Vercel: https://tudominio.com — local: http://localhost:3000
SITE_URL=
